# Required: SEC EDGAR User-Agent (SEC will IP-ban requests missing this header)
# Format: "<AppName> <ContactEmail>"
EDGAR_USER_AGENT=Tickerlens Personal <your-email@example.com>

# Optional: override SQLite path (default: sqlite:///tickerlens.db)
# DATABASE_URL=sqlite:///tickerlens.db

# Optional: shared passcode gate for public hosting (Railway)
# When set, requires visitors to enter the passcode to access the site
# TICKERLENS_PASSCODE=your_secret_passcode
